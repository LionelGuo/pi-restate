{
	"name": "pi-restate",
	"version": "0.1.0",
	"description": "/restate command for Pi: retract the latest turn from model context via append-only context edits, keeping the session on a single chain.",
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LionelGuo/pi-restate.git"
	},
	"bugs": {
		"url": "https://github.com/LionelGuo/pi-restate/issues"
	},
	"homepage": "https://github.com/LionelGuo/pi-restate#readme",
	"main": "./src/index.ts",
	"scripts": {
		"test": "vitest run",
		"check": "tsc --noEmit"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-agent-core": "^1.3.0",
		"@earendil-works/pi-ai": "^1.3.0",
		"@earendil-works/pi-coding-agent": "^1.3.0",
		"@earendil-works/pi-tui": "^1.3.0",
		"@types/node": "^22.10.0",
		"typescript": "^5.7.0",
		"vitest": "^3.0.0"
	},
	"overrides": {
		"@aws-sdk/credential-provider-http": "3.972.76",
		"@aws-sdk/credential-provider-node": "3.972.82"
